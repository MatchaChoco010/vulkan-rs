    (RENDER, "depth_stencil.slang", "fragmentMain", "fragment", "depth_stencil.frag.spv", GLSL_450),
    (RENDER, "texture_mipmap.slang", "vertexMain", "vertex", "texture_mipmap.vert.spv", GLSL_450),
    (RENDER, "texture_mipmap.slang", "fragmentMain", "fragment", "texture_mipmap.frag.spv", GLSL_450),
    (RENDER, "multiple_render_targets.slang", "vertexMain", "vertex", "multiple_render_targets.vert.spv", GLSL_450),
    (RENDER, "multiple_render_targets.slang", "fragmentMain", "fragment", "multiple_render_targets.frag.spv", GLSL_450),
    (RENDER, "multiple_render_targets.slang", "compositeVertexMain", "vertex", "multiple_render_targets.composite.vert.spv", GLSL_450),
