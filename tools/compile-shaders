    (RENDER, "shader_objects.slang", "fragmentMain", "fragment", "shader_objects.frag.spv", GLSL_450),
    (RENDER, "ray_query.slang", "vertexMain", "vertex", "ray_query.vert.spv", GLSL_450),
    (RENDER, "ray_query.slang", "fragmentMain", "fragment", "ray_query.frag.spv", RAY_QUERY),
