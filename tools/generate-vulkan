#!/usr/bin/env python3
"""Regenerate the `vulkan` crate from `third_party/vulkan` (Khronos Vulkan-Headers).

Pipeline:

1. Load the registry (`vk.xml` + `video.xml`) through Khronos' own `VulkanObject`
   abstraction and dump it, unmodified, to `crates/vulkan-registry/vulkan-ir.json`.
   All Rust naming and shaping decisions live in `vulkan-codegen`, not here.
2. Run `vulkan-codegen`, which writes the generated sources and test tables.
3. Format the generated Rust with rustfmt.

`--check` regenerates and fails if any generated file differs from what is committed.
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path
from xml.etree import ElementTree


ROOT = Path(__file__).resolve().parents[1]
HEADERS = ROOT / "third_party" / "vulkan"
REGISTRY = HEADERS / "registry"
IR_PATH = ROOT / "crates" / "vulkan-registry" / "vulkan-ir.json"
GENERATED_DIRS = [
    ROOT / "crates" / "vulkan" / "src" / "vk" / "generated",
    ROOT / "crates" / "vulkan" / "tests" / "generated",
]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument(
        "--allow-non-sdk-tag",
        action="store_true",
        help="allow generating from a non vulkan-sdk-* tag for development snapshots",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="regenerate, then fail if the generated files differ from the committed ones",
    )
    args = parser.parse_args()

    if not (REGISTRY / "vk.xml").exists():
        print(
            "third_party/vulkan is empty; run `git submodule update --init` first",
            file=sys.stderr,
        )
        return 1

    vk = load_vulkan_object()
    ir = build_ir(vk, args.allow_non_sdk_tag)
    IR_PATH.write_text(json.dumps(ir, indent=1, sort_keys=True) + "\n")

    subprocess.run(
        ["cargo", "run", "--quiet", "-p", "vulkan-codegen", "--", str(ROOT)],
        cwd=ROOT,
        check=True,
    )
    for directory in GENERATED_DIRS:
        files = sorted(str(file) for file in directory.glob("*.rs"))
        if files:
            subprocess.run(["rustfmt", "--edition", "2024", *files], cwd=ROOT, check=True)

    if args.check:
        paths = [str(IR_PATH.relative_to(ROOT)), *(str(d.relative_to(ROOT)) for d in GENERATED_DIRS)]
        status = git(["status", "--porcelain", "--", *paths])
        if status:
            print("generated files are stale; run ./tools/generate-vulkan and commit:", file=sys.stderr)
            print(status, file=sys.stderr)
            return 1
    return 0


def load_vulkan_object():
    sys.path.insert(0, str(REGISTRY))
    import base_generator  # type: ignore
    from reg import Registry  # type: ignore

    scratch = ROOT / "target" / "vulkan-ir"
    scratch.mkdir(parents=True, exist_ok=True)

    class IrGenerator(base_generator.BaseGenerator):
        def generate(self):
            pass

    # Khronos' BaseGenerator builds and owns the VulkanObject abstraction in `gen.vk`.
    # Keep all registry interpretation behind that object instead of walking vk.xml ourselves.
    base_generator.SetTargetApiName("vulkan")
    base_generator.SetMergedApiNames(None)
    base_generator.SetOutputDirectory(str(scratch))
    base_generator.SetOutputFileName("vulkan-ir")

    opts = base_generator.BaseGeneratorOptions(
        customFileName="vulkan-ir",
        customDirectory=str(scratch),
        customApiName="vulkan",
        videoXmlPath=str(REGISTRY / "video.xml"),
    )
    gen = IrGenerator()
    registry = Registry(gen, opts)
    registry.loadElementTree(ElementTree.parse(REGISTRY / "vk.xml"))
    registry.apiGen()
    return gen.vk


def headers_tag(allow_non_sdk_tag: bool) -> str:
    exact_tags = git(["-C", str(HEADERS), "tag", "--points-at", "HEAD"], allow_fail=True).splitlines()
    sdk_tags = sorted(tag for tag in exact_tags if tag.startswith("vulkan-sdk-"))
    if sdk_tags:
        return sdk_tags[-1]
    if allow_non_sdk_tag:
        return git(["-C", str(HEADERS), "describe", "--tags", "--always"])
    raise RuntimeError(
        "third_party/vulkan is not at an exact vulkan-sdk-* tag. "
        "Use --allow-non-sdk-tag for development snapshots; "
        f"current exact tags are {', '.join(exact_tags) or '<none>'}"
    )


def build_ir(vk, allow_non_sdk_tag: bool):
    video = attr(vk, "videoStd")
    constants = list(vk.constants.values())
    enums = list(vk.enums.values())
    structs = list(vk.structs.values())
    video_headers = []
    if video is not None:
        constants.extend(video.constants.values())
        enums.extend(video.enums.values())
        structs.extend(video.structs.values())
        video_headers = [
            {
                "name": h.name,
                "header_file": h.headerFile,
                "depends": list(h.depends),
            }
            for h in sorted(video.headers.values(), key=lambda x: x.name)
        ]

    return {
        "header_version": int(vk.headerVersion),
        "header_version_complete": vk.headerVersionComplete,
        "headers_tag": headers_tag(allow_non_sdk_tag),
        "headers_commit": git(["-C", str(HEADERS), "rev-parse", "--short=12", "HEAD"]),
        "vendor_tags": sorted(vk.vendorTags),
        "platforms": dict(sorted(vk.platforms.items())),
        "video_headers": video_headers,
        "versions": [
            {"name": v.name, "name_api": v.nameApi}
            for v in sorted(vk.versions.values(), key=lambda x: x.name)
        ],
        "constants": [
            {
                "name": c.name,
                "ty": c.type,
                "value": constant_value(c),
                "video_std_header": attr(c, "videoStdHeader"),
            }
            for c in sorted(constants, key=lambda x: x.name)
        ],
        "handles": [
            {
                "name": h.name,
                "aliases": sorted(h.aliases),
                "object_type": h.type,
                "parent": h.parent.name if h.parent is not None else None,
                "dispatchable": h.dispatchable,
                "protect": effective_protect(vk, h),
                "extensions": list(h.extensions),
            }
            for h in sorted(vk.handles.values(), key=lambda x: x.name)
        ],
        "enums": [
            {
                "name": e.name,
                "aliases": sorted(e.aliases),
                "bit_width": e.bitWidth,
                "protect": effective_protect(vk, e),
                "video_std_header": attr(e, "videoStdHeader"),
                "fields": [
                    {
                        "name": f.name,
                        "aliases": sorted(f.aliases),
                        "value": str(f.value),
                        "protect": f.protect,
                    }
                    for f in sorted(e.fields, key=lambda x: (x.value, x.name))
                ],
            }
            for e in sorted(enums, key=lambda x: x.name)
        ],
        "bitmasks": [
            {
                "name": b.name,
                "aliases": sorted(b.aliases),
                "flags_name": b.flagName,
                "bit_width": b.bitWidth,
                "protect": effective_protect(vk, b),
                "fields": [
                    {
                        "name": f.name,
                        "aliases": sorted(f.aliases),
                        "value": str(f.value),
                        "protect": f.protect,
                        "multi_bit": f.multiBit,
                    }
                    for f in sorted(b.flags, key=lambda x: (x.value, x.name))
                ],
            }
            for b in sorted(vk.bitmasks.values(), key=lambda x: x.name)
        ],
        "flags": [
            {
                "name": f.name,
                "aliases": sorted(f.aliases),
                "bitmask": f.bitmaskName,
                "bit_width": f.bitWidth,
                "protect": effective_protect(vk, f),
            }
            for f in sorted(vk.flags.values(), key=lambda x: x.name)
        ],
        "func_pointers": [
            {
                "name": fp.name,
                "return_ty": fp.returnType,
                "protect": fp.protect,
                "params": [{"name": p.name, "ty": p.type, "full_ty": p.fullType} for p in fp.params],
            }
            for fp in sorted(vk.funcPointers.values(), key=lambda x: x.name)
        ],
        "structs": [
            {
                "name": s.name,
                "aliases": sorted(s.aliases),
                "union": s.union,
                "s_type": s.sType,
                "extends": sorted(s.extends),
                "allow_duplicate": s.allowDuplicate,
                "returned_only": s.returnedOnly,
                "protect": effective_protect(vk, s),
                "extensions": list(s.extensions),
                "version": s.version.name if s.version is not None else None,
                "video_std_header": attr(s, "videoStdHeader"),
                "members": [member_ir(m) for m in s.members],
            }
            for s in sorted(structs, key=lambda x: x.name)
        ],
        "commands": [
            {
                "name": c.name,
                "alias": c.alias,
                "return_ty": c.returnType,
                "success_codes": list(c.successCodes),
                "error_codes": list(c.errorCodes),
                "instance": c.instance,
                "device": c.device,
                "protect": effective_protect(vk, c),
                "extensions": list(c.extensions),
                "version": c.version.name if c.version is not None else None,
                "params": [param_ir(p) for p in c.params],
            }
            for c in sorted(vk.commands.values(), key=lambda x: x.name)
        ],
        "extensions": [
            {
                "name": e.name,
                "name_macro": e.nameString,
                "spec_version_macro": e.specVersion,
                "spec_version": e.specVersionValue,
                "instance": e.instance,
                "device": e.device,
                "depends": e.depends,
                "platform": e.platform,
                "protect": e.protect,
                "provisional": e.provisional,
                "promoted_to": e.promotedTo,
                "deprecated_by": e.deprecatedBy,
                "obsoleted_by": e.obsoletedBy,
            }
            for e in sorted(vk.extensions.values(), key=lambda x: x.name)
        ],
    }


def param_ir(p):
    return {
        "name": p.name,
        "ty": p.type,
        "full_ty": p.fullType,
        "is_const": p.const,
        "pointer": p.pointer,
        "optional": p.optional,
        "optional_pointer": p.optionalPointer,
        "len": p.length,
        "null_terminated": p.nullTerminated,
        "fixed_size_array": list(p.fixedSizeArray),
        "object_type": p.objectType,
    }


def member_ir(m):
    ir = param_ir(m)
    ir["bit_field_width"] = m.bitFieldWidth
    ir["selector"] = m.selector
    ir["selection"] = list(m.selection)
    return ir


def effective_protect(vk, item):
    if item.protect:
        return item.protect
    for ext_name in item.extensions or []:
        ext = vk.extensions.get(ext_name)
        if ext and ext.protect:
            return ext.protect
    return None


def constant_value(c) -> str:
    if c.type == "float":
        return repr(float(c.value))
    return str(int(c.value))


def attr(obj, name: str):
    # Attribute access is otherwise direct on purpose: if Khronos renames or drops a
    # VulkanObject field, generation must fail loudly instead of emitting a silent default.
    return getattr(obj, name, None)


def git(args, allow_fail=False):
    try:
        return subprocess.check_output(["git", *args], cwd=ROOT, text=True).strip()
    except subprocess.CalledProcessError:
        if allow_fail:
            return ""
        raise


if __name__ == "__main__":
    raise SystemExit(main())
