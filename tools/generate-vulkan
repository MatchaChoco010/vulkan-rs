#!/usr/bin/env python3
"""Regenerate the `vulkan` crate from `third_party/vulkan` (Khronos Vulkan-Headers) and
`third_party/vulkan-docs` (Khronos Vulkan-Docs, the source of the Vulkan Specification).

Pipeline:

1. Load the registry (`vk.xml` + `video.xml`) through Khronos' own `VulkanObject`
   abstraction and dump the parts the generator uses, unmodified, to
   `crates/vulkan-registry/vulkan-ir.json`. All Rust naming and shaping decisions live
   in `vulkan-codegen`, not here. Only attributes that the generator reads are dumped:
   every extra one is one more way for a Vulkan-Headers update to break this script.
   The `<deprecate>` blocks, which mark functionality as legacy, are read from the
   registry tree itself, because `VulkanObject` has them for commands only, and so are
   the `deprecated` attributes, which it does not have.
2. Dump the descriptions that the specification gives for the registry's names, as the
   AsciiDoc text of the specification, to `crates/vulkan-registry/vulkan-docs.json`.
   Turning that text into rustdoc is `vulkan-codegen`'s job as well.
3. Run `vulkan-codegen`, which writes the generated sources and test tables.
4. Format the generated Rust with rustfmt.

`--check` regenerates and fails if any generated file differs from what is committed.
"""
from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path
from xml.etree import ElementTree


ROOT = Path(__file__).resolve().parents[1]
HEADERS = ROOT / "third_party" / "vulkan"
REGISTRY = HEADERS / "registry"
DOCS = ROOT / "third_party" / "vulkan-docs"
IR_PATH = ROOT / "crates" / "vulkan-registry" / "vulkan-ir.json"
DOCS_PATH = ROOT / "crates" / "vulkan-registry" / "vulkan-docs.json"
GENERATED_DIRS = [
    ROOT / "crates" / "vulkan" / "src" / "vk" / "generated",
    ROOT / "crates" / "vulkan" / "tests" / "generated",
]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument(
        "--allow-non-sdk-tag",
        action="store_true",
        help="allow generating from a non vulkan-sdk-* tag for development snapshots",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="regenerate, then fail if the generated files differ from the committed ones",
    )
    args = parser.parse_args()

    if not (REGISTRY / "vk.xml").exists():
        print(
            "third_party/vulkan is empty; run `git submodule update --init` first",
            file=sys.stderr,
        )
        return 1

    if not (DOCS / "vkspec.adoc").exists():
        print(
            "third_party/vulkan-docs is empty; run `git submodule update --init` first",
            file=sys.stderr,
        )
        return 1
    # Vulkan-Headers takes both registry files from Vulkan-Docs, so equal files mean that
    # the descriptions and the registry belong to the same revision of the specification.
    for registry_file in ("vk.xml", "video.xml"):
        if (DOCS / "xml" / registry_file).read_bytes() != (REGISTRY / registry_file).read_bytes():
            print(
                f"third_party/vulkan-docs/xml/{registry_file} differs from "
                f"third_party/vulkan/registry/{registry_file}: check out the Vulkan-Docs tag "
                "that the Vulkan-Headers revision was generated from "
                "(tools/update-vulkan-headers does)",
                file=sys.stderr,
            )
            return 1

    vk, registry_tree, attributes = load_vulkan_object()
    ir = build_ir(vk, registry_tree, attributes, args.allow_non_sdk_tag)
    IR_PATH.write_text(json.dumps(ir, indent=1, sort_keys=True) + "\n")
    linked_anchors = {mark["link"] for mark in ir["legacy"]}
    docs = build_docs(defined_spec_attributes(vk), spec_generated_files(vk), linked_anchors)
    docs["commit"] = git(["-C", str(DOCS), "rev-parse", "--short=12", "HEAD"])
    DOCS_PATH.write_text(json.dumps(docs, indent=1, sort_keys=True, ensure_ascii=False) + "\n")

    subprocess.run(
        ["cargo", "run", "--quiet", "-p", "vulkan-codegen", "--", str(ROOT)],
        cwd=ROOT,
        check=True,
    )
    for directory in GENERATED_DIRS:
        files = sorted(str(file) for file in directory.glob("*.rs"))
        if files:
            subprocess.run(["rustfmt", "--edition", "2024", *files], cwd=ROOT, check=True)

    if args.check:
        paths = [
            str(IR_PATH.relative_to(ROOT)),
            str(DOCS_PATH.relative_to(ROOT)),
            *(str(d.relative_to(ROOT)) for d in GENERATED_DIRS),
        ]
        status = git(["status", "--porcelain", "--", *paths])
        if status:
            print("generated files are stale; run ./tools/generate-vulkan and commit:", file=sys.stderr)
            print(status, file=sys.stderr)
            return 1
    return 0


def load_registry(xml: Path):
    """Khronos' Registry with a registry file loaded, and its generator.

    Loading reduces the tree, `registry.reg`, to the `vulkan` API: it drops the elements
    of other APIs and merges the internal `VK_BASE_VERSION_*`, `VK_COMPUTE_VERSION_*` and
    `VK_GRAPHICS_VERSION_*` features into the `VK_VERSION_*` feature that they are a part
    of. It also copies every enumerant that a version or an extension adds to a type into
    the `<enums>` group of that type, where the copy of one from an extension names the
    extension as `extname`."""
    if str(REGISTRY) not in sys.path:
        sys.path.insert(0, str(REGISTRY))
    import base_generator  # type: ignore
    from reg import Registry  # type: ignore

    scratch = ROOT / "target" / "vulkan-ir"
    scratch.mkdir(parents=True, exist_ok=True)

    class IrGenerator(base_generator.BaseGenerator):
        def generate(self):
            pass

    # Khronos' BaseGenerator builds and owns the VulkanObject abstraction in `gen.vk`.
    # Keep all registry interpretation behind that object instead of walking vk.xml ourselves.
    base_generator.SetTargetApiName("vulkan")
    base_generator.SetMergedApiNames(None)
    base_generator.SetOutputDirectory(str(scratch))
    base_generator.SetOutputFileName("vulkan-ir")

    opts = base_generator.BaseGeneratorOptions(
        customFileName="vulkan-ir",
        customDirectory=str(scratch),
        customApiName="vulkan",
        videoXmlPath=str(REGISTRY / "video.xml"),
    )
    gen = IrGenerator()
    registry = Registry(gen, opts)
    registry.loadElementTree(ElementTree.parse(xml))
    return registry, gen


def load_vulkan_object():
    registry, gen = load_registry(REGISTRY / "vk.xml")
    # The `deprecated` attributes are read before `apiGen`, which gives the attribute to
    # the members that `<deprecate>` blocks mark as features.
    attributes = legacy_attributes(registry.reg)
    attributes += legacy_attributes(load_registry(REGISTRY / "video.xml")[0].reg)
    registry.apiGen()
    return gen.vk, registry.reg, attributes


def sdk_tag_key(tag: str) -> tuple[int, ...]:
    return tuple(int(part) for part in tag.removeprefix("vulkan-sdk-").split("."))


def headers_tag(allow_non_sdk_tag: bool) -> str:
    exact_tags = git(["-C", str(HEADERS), "tag", "--points-at", "HEAD"], allow_fail=True).splitlines()
    sdk_tags = [tag for tag in exact_tags if tag.startswith("vulkan-sdk-")]
    if sdk_tags:
        # One commit can carry several SDK tags (1.4.350.0 and 1.4.350.1 do). The newest
        # one names the bindings; tools/update-vulkan-headers relies on the same rule.
        return max(sdk_tags, key=sdk_tag_key)
    if allow_non_sdk_tag:
        return git(["-C", str(HEADERS), "describe", "--tags", "--always"])
    raise RuntimeError(
        "third_party/vulkan is not at an exact vulkan-sdk-* tag. "
        "Use --allow-non-sdk-tag for development snapshots; "
        f"current exact tags are {', '.join(exact_tags) or '<none>'}"
    )


LEGACY_KINDS = ("type", "command", "feature")


def legacy_ir(vk, registry_tree):
    """The names that the `<deprecate>` blocks of the registry mark as legacy, each with
    every version and extension that marks it, in the order of the registry.

    A block belongs to the version or extension that it is in, and names the section of
    the specification that explains it. It lists types, commands and features (members of
    features structures, named with their structure), some with the name of what
    supersedes them. Khronos' reg.py keeps one link and one `supersededby` for a name,
    however many blocks list it, so a name that two blocks describe differently has no
    single answer and stops the generation. The blocks of extensions that the registry
    does not support for the `vulkan` API are left out, as these extensions are."""
    marks = {}
    interfaces = [*registry_tree.findall("feature"), *registry_tree.findall("extensions/extension")]
    for interface in interfaces:
        marked_by = interface.get("name")
        if interface.tag == "extension" and marked_by not in vk.extensions:
            continue
        for block in interface.findall("deprecate"):
            link = block.get("explanationlink")
            if not link:
                raise RuntimeError(f"{marked_by}: a <deprecate> block without an explanationlink")
            for marked in block:
                name = marked.get("name")
                structure = marked.get("struct")
                if marked.tag not in LEGACY_KINDS:
                    raise RuntimeError(
                        f"{marked_by}: a <deprecate> block lists a <{marked.tag}> ({name}), "
                        "which this script does not know"
                    )
                if not name or (marked.tag == "feature") != (structure is not None):
                    raise RuntimeError(
                        f"{marked_by}: a <deprecate> block lists a <{marked.tag}> with the "
                        f"attributes {dict(marked.attrib)}: it needs a name, and a struct "
                        "if and only if it is a feature"
                    )
                superseded_by = marked.get("supersededby")
                mark = marks.setdefault(
                    (marked.tag, structure or "", name),
                    {
                        "kind": marked.tag,
                        "name": name,
                        "structure": structure,
                        "link": link,
                        "superseded_by": superseded_by,
                        "marked_by": [],
                    },
                )
                for attribute, value in (("link", link), ("superseded_by", superseded_by)):
                    if mark[attribute] != value:
                        raise RuntimeError(
                            f"{name} is marked as legacy by {mark['marked_by'][0]} with the "
                            f"{attribute} {mark[attribute]} and by {marked_by} with {value}"
                        )
                if marked_by not in mark["marked_by"]:
                    mark["marked_by"].append(marked_by)
    return [marks[key] for key in sorted(marks)]


LEGACY_ATTRIBUTE_ELEMENTS = ("enum", "member")
LEGACY_ATTRIBUTE_VALUES = ("aliased", "true", "unused")


def legacy_attributes(tree) -> list[dict]:
    """The elements of a registry tree that have the `deprecated` attribute, in the order
    of the tree: enumerants and constants (`<enum>`, in an `<enums>` group or required by
    a version or an extension) and members of structures. Each one comes with the value of
    the attribute, with the type that owns it (the group or the `extends` of an enumerant,
    none for a constant; the structure of a member), with the `alias` attribute, and with
    the extension that it is in, if any.

    The tree is one that `load_registry` has loaded, so an enumerant that an extension
    adds to a type is in it twice, in the extension and as a copy in the group of the
    type. Both name the extension as `extname`, and `legacy_attributes_ir` takes the two
    for one.

    Khronos' generators write a comment for the attribute wherever it is, and for three
    values (`deprecationComment` in generator.py). Another element or another value stops
    the generation: this script would not know what it stands for."""
    found = []

    def visit(element, owner, extension):
        for child in element:
            child_owner, child_extension = owner, extension
            if child.tag == "enums":
                child_owner = child.get("name") if child.get("type") in ("enum", "bitmask") else None
            elif child.tag == "type":
                child_owner = child.get("name")
            elif child.tag == "extension":
                child_extension = child.get("name")
            elif child.tag == "enum":
                child_extension = child.get("extname", extension)
            reason = child.get("deprecated")
            if reason is not None:
                name = child.get("name") or child.findtext("name")
                if child.tag not in LEGACY_ATTRIBUTE_ELEMENTS:
                    raise RuntimeError(
                        f"a <{child.tag}> ({name}) has the attribute deprecated=\"{reason}\", "
                        "which this script knows on <enum> and <member> only"
                    )
                if reason not in LEGACY_ATTRIBUTE_VALUES:
                    raise RuntimeError(
                        f"{name} has the attribute deprecated=\"{reason}\", a value that this "
                        "script does not know"
                    )
                attribute_owner = child.get("extends", owner) if child.tag == "enum" else owner
                if not name or (child.tag == "member" and not attribute_owner):
                    raise RuntimeError(
                        f"a <{child.tag}> with the attribute deprecated=\"{reason}\" has no "
                        f"name, or is a member of no type: {dict(child.attrib)}"
                    )
                found.append(
                    {
                        "element": child.tag,
                        "name": name,
                        "owner": attribute_owner,
                        "reason": reason,
                        "alias": child.get("alias"),
                        "extension": child_extension,
                    }
                )
            visit(child, child_owner, child_extension)

    visit(tree, None, None)
    return found


def legacy_attributes_ir(supported_extensions, attributes: list[dict]) -> list[dict]:
    """`attributes` without the ones in extensions that are not supported, each name once.
    A name that the registry gives the attribute twice, with different values or as an
    alias of different names, has no single answer and stops the generation."""
    stated = {}
    for attribute in attributes:
        if attribute["extension"] is not None and attribute["extension"] not in supported_extensions:
            continue
        entry = {key: attribute[key] for key in ("element", "name", "owner", "reason", "alias")}
        earlier = stated.setdefault((entry["element"], entry["owner"] or "", entry["name"]), entry)
        if earlier != entry:
            raise RuntimeError(
                f"{entry['name']} has the attribute `deprecated` twice, as {earlier} and as {entry}"
            )
    return [stated[key] for key in sorted(stated)]


def build_ir(vk, registry_tree, attributes, allow_non_sdk_tag: bool):
    video = attr(vk, "videoStd")
    constants = list(vk.constants.values())
    enums = list(vk.enums.values())
    structs = list(vk.structs.values())
    video_headers = []
    if video is not None:
        constants.extend(video.constants.values())
        enums.extend(video.enums.values())
        structs.extend(video.structs.values())
        video_headers = [
            {
                "name": h.name,
                "header_file": h.headerFile,
                "depends": list(h.depends),
            }
            for h in sorted(video.headers.values(), key=lambda x: x.name)
        ]

    return {
        "header_version": int(vk.headerVersion),
        "header_version_complete": vk.headerVersionComplete,
        "headers_tag": headers_tag(allow_non_sdk_tag),
        "headers_commit": git(["-C", str(HEADERS), "rev-parse", "--short=12", "HEAD"]),
        "vendor_tags": sorted(vk.vendorTags),
        "platforms": dict(sorted(vk.platforms.items())),
        "video_headers": video_headers,
        "versions": [
            {"name": v.name, "name_api": v.nameApi}
            for v in sorted(vk.versions.values(), key=lambda x: x.name)
        ],
        "constants": [
            {
                "name": c.name,
                "ty": c.type,
                "value": constant_value(c),
                "video_std_header": attr(c, "videoStdHeader"),
            }
            for c in sorted(constants, key=lambda x: x.name)
        ],
        "handles": [
            {
                "name": h.name,
                "aliases": sorted(h.aliases),
                "object_type": h.type,
                "parent": h.parent.name if h.parent is not None else None,
                "dispatchable": h.dispatchable,
                "protect": effective_protect(vk, h),
                "extensions": list(h.extensions),
            }
            for h in sorted(vk.handles.values(), key=lambda x: x.name)
        ],
        "enums": [
            {
                "name": e.name,
                "aliases": sorted(e.aliases),
                "bit_width": e.bitWidth,
                "protect": effective_protect(vk, e),
                "video_std_header": attr(e, "videoStdHeader"),
                "fields": [
                    {
                        "name": f.name,
                        "aliases": sorted(f.aliases),
                        "value": str(f.value),
                        "protect": f.protect,
                    }
                    for f in sorted(e.fields, key=lambda x: (x.value, x.name))
                ],
            }
            for e in sorted(enums, key=lambda x: x.name)
        ],
        "bitmasks": [
            {
                "name": b.name,
                "aliases": sorted(b.aliases),
                "flags_name": b.flagName,
                "bit_width": b.bitWidth,
                "protect": effective_protect(vk, b),
                "fields": [
                    {
                        "name": f.name,
                        "aliases": sorted(f.aliases),
                        "value": str(f.value),
                        "protect": f.protect,
                    }
                    for f in sorted(b.flags, key=lambda x: (x.value, x.name))
                ],
            }
            for b in sorted(vk.bitmasks.values(), key=lambda x: x.name)
        ],
        "flags": [
            {
                "name": f.name,
                "aliases": sorted(f.aliases),
                "bitmask": f.bitmaskName,
                "bit_width": f.bitWidth,
                "protect": effective_protect(vk, f),
            }
            for f in sorted(vk.flags.values(), key=lambda x: x.name)
        ],
        "func_pointers": [
            {
                "name": fp.name,
                "return_ty": fp.returnType,
                "protect": fp.protect,
                "params": [{"name": p.name, "full_ty": p.fullType} for p in fp.params],
            }
            for fp in sorted(vk.funcPointers.values(), key=lambda x: x.name)
        ],
        "structs": [
            {
                "name": s.name,
                "aliases": sorted(s.aliases),
                "union": s.union,
                "s_type": s.sType,
                "extends": sorted(s.extends),
                "protect": effective_protect(vk, s),
                "extensions": list(s.extensions),
                "version": s.version.name if s.version is not None else None,
                "video_std_header": attr(s, "videoStdHeader"),
                "members": [member_ir(m) for m in s.members],
            }
            for s in sorted(structs, key=lambda x: x.name)
        ],
        "commands": [
            {
                "name": c.name,
                "alias": c.alias,
                "return_ty": c.returnType,
                "success_codes": list(c.successCodes),
                "error_codes": list(c.errorCodes),
                "instance": c.instance,
                "device": c.device,
                "protect": effective_protect(vk, c),
                "extensions": list(c.extensions),
                "version": c.version.name if c.version is not None else None,
                "params": [param_ir(p) for p in c.params],
            }
            for c in sorted(vk.commands.values(), key=lambda x: x.name)
        ],
        "extensions": [
            {
                "name": e.name,
                "name_macro": e.nameString,
                "spec_version_macro": e.specVersion,
                "spec_version": e.specVersionValue,
                "instance": e.instance,
                "device": e.device,
                "protect": e.protect,
                "depends": e.depends,
                "promoted_to": e.promotedTo,
                "deprecated_by": e.deprecatedBy,
                "obsoleted_by": e.obsoletedBy,
                "provisional": e.provisional,
            }
            for e in sorted(vk.extensions.values(), key=lambda x: x.name)
        ],
        "legacy": legacy_ir(vk, registry_tree),
        "legacy_attributes": legacy_attributes_ir(
            {*vk.extensions, *(header["name"] for header in video_headers)}, attributes
        ),
        "formats": [
            {
                "name": f.name,
                "class": f.className,
                "block_size": f.blockSize,
                "texels_per_block": f.texelsPerBlock,
                "block_extent": [int(x) for x in f.blockExtent],
                "packed": f.packed,
                "chroma": f.chroma,
                "compressed": f.compressed,
                "components": [
                    {
                        "name": c.type,
                        "bits": None if c.bits == "compressed" else int(c.bits),
                        "numeric_format": c.numericFormat,
                        "plane_index": c.planeIndex,
                    }
                    for c in f.components
                ],
                "planes": [
                    {
                        "index": p.index,
                        "width_divisor": p.widthDivisor,
                        "height_divisor": p.heightDivisor,
                        "compatible": p.compatible,
                    }
                    for p in f.planes
                ],
            }
            for f in sorted(vk.formats.values(), key=lambda x: x.name)
        ],
    }


# --- Descriptions from the specification -------------------------------------------------
#
# The specification marks the text that documents one name of the API as an open block:
#
#     [open,refpage='VkExtent2D',desc='Structure specifying a two-dimensional extent',type='structs']
#     --
#     ...
#       * pname:width is the width of the extent.
#       * pname:height is the height of the extent.
#     --
#
# Khronos builds the reference pages from these blocks. For each block this dumps the
# short description and the list items that start with the name of a member, a parameter
# or an enumerant. Some types describe their values in a table instead, so the tables that
# name an enumerant are dumped as well, whether they are in a block or not. A few values
# are described in a list outside the blocks, so the list items out there that start with
# the name of an enumerant are dumped too. The list items in the cells of a table are not
# read as items: they are a part of the table.

SPEC_CONDITIONAL = re.compile(r"^(ifdef|ifndef)::([^\[]*)\[(.*)\]\s*$")
SPEC_END_CONDITIONAL = re.compile(r"^endif::[^\[]*\[\]\s*$")
SPEC_INCLUDE_TAG = re.compile(r"^include::\{chapters\}/([^\[]+)\[tags?=([^\],;]+)\]\s*$")
SPEC_TAG_MARKER = re.compile(r"^// (tag|end)::([^\[]+)\[\]\s*$")
SPEC_REFPAGE = re.compile(r"^\[open,(refpage=.*)\]\s*$")
SPEC_REFPAGE_ATTRIBUTE = re.compile(r"(\w+)='((?:[^'\\]|\\.)*)'")
SPEC_LIST_ITEM = re.compile(r"^\s*(\*+)\s+(\S.*)$")
SPEC_ANCHOR = re.compile(r"\[\[[^\]]*\]\]\s*")
SPEC_DESCRIBED_NAME = re.compile(r"^(?:pname|ename):(\w+)\b")
SPEC_DESCRIBED_VALUE = re.compile(r"^ename:(\w+)\b")
SPEC_ATTRIBUTE_ENTRY = re.compile(r"^:([\w-]+)(!?):\s*(.*)$")
SPEC_ATTRIBUTE_REFERENCE = re.compile(r"\{([\w-]+)\}")
SPEC_ANCHOR_LINE = re.compile(r"^\[\[([\w.-]+)\]\]\s*$")
SPEC_ANCHOR_DEFINITION = re.compile(r"\[\[([\w.-]+)\]\]")
# The term of a description list that starts with an anchor, as Asciidoctor reads the two
# (`DescriptionListRx` and `LeadingInlineAnchorRx`).
SPEC_TERM_ANCHOR = re.compile(r"^[ \t]*\[\[([\w.-]+)\]\](.*?)(?::{2,4}|;;)(?:$|[ \t])")
# The four below are the rules of the Antora build of the specification, which publishes
# it on docs.vulkan.org: `spec_pages` in antora/Makefile and `findTitle` in
# scripts/antora-prep.py of Vulkan-Docs.
SPEC_PAGE_FILE_NAME = re.compile(r"[A-Za-z].*\.adoc")
SPEC_PAGE_TITLE_SEARCH_LINES = 30
SPEC_TITLE_ANCHOR = re.compile(r"^\[\[[^,]+.*\]\]$")
SPEC_PAGE_TITLE = re.compile(r"^[=#] [A-Z].*")
SPEC_PARTIAL_TITLE = re.compile(r"^[=#]{2,} [A-Z].*")
SPEC_SECTION_TITLE = re.compile(r"^=+ +(\S.*?)\s*$")
SPEC_BLOCK_TITLE = re.compile(r"^\.([^\s.].*?)\s*$")
SPEC_IMAGE_TITLE = re.compile(r"^image::.*\btitle=\"([^\"]+)\"")
SPEC_BARE_REFERENCE = re.compile(r"<<([\w.-]+)>>")
SPEC_PASSTHROUGH = re.compile(r"^pass:\w*\[(.*)\]$")
SPEC_TABLE_DELIMITER = re.compile(r"^\|={3,}\s*$")
SPEC_BLOCK_HEADER = re.compile(r"^(?:\[.*\]|\.[^\s.].*)\s*$")
SPEC_INCLUDE_GENERATED = re.compile(r"^include::\{generated\}/([^\[]+)\[\]\s*$")
# The three below are the rules of Asciidoctor, which reads them at the left margin only.
SPEC_LIST_CONTINUATION = "+"
SPEC_BLOCK_ATTRIBUTES = re.compile(r"^\[(?:|[\w.#%{,\"'].*)\]$")
SPEC_BLOCK_DELIMITER = re.compile(r"^(?:--|={4,}|-{4,}|\.{4,}|\*{4,}|_{4,}|\+{4,}|/{4,}|[|,:!]={3,}|`{3,})$")
# The first line of a list that is not marked with asterisks, as Asciidoctor reads it: an
# item marked with a hyphen or a bullet, a numbered item, or a term with its description.
SPEC_OTHER_LIST_ITEM = re.compile(
    r"^[ \t]*(?:(?:-|•|\.{1,5}|\d+\.|[a-zA-Z]\.|[IVXivx]+\))[ \t]+\S"
    r"|(?!//[^/])\S.*?(?::{2,4}|;;)(?:$|[ \t]+\S))"
)
# A term, with the description on its line, if it has one.
SPEC_TERM = re.compile(r"^[ \t]*(?!//[^/])\S.*?(?::{2,4}|;;)(?:$|[ \t]+(\S.*)$)")
# Generated files and shared valid usage that follow a list item without an empty line
# between them hold blocks of their own, not more text of the item.
SPEC_INCLUDES_AFTER_AN_ITEM = (
    "include::{generated}/validity/",
    "include::{generated}/api/",
    "include::{chapters}/commonvalidity/",
)


def defined_spec_attributes(vk) -> set[str]:
    """Names that `ifdef::` sees as defined when the specification is built with every
    version and every extension of the `vulkan` API."""
    features = ElementTree.parse(REGISTRY / "vk.xml").getroot().findall("feature")
    versions = {f.get("name") for f in features if "vulkan" in f.get("api", "").split(",")}
    return versions | set(vk.extensions)


def spec_generated_files(vk) -> dict[str, list[str]]:
    """The lines of the files that a build of the specification generates from the registry
    and includes in the text that describes a name, by their path under `{generated}`.

    `sync/flagDefinitions/<flag>.adoc` lists the flags that a synchronization flag stands
    for (`<syncequivalent>` in vk.xml), one nested list item each, in the order of the
    registry and without the flags that the `vulkan` API does not have. This is what
    `scripts/syncgenerator.py` of Vulkan-Docs writes for a build with every version and
    every extension."""
    registry = ElementTree.parse(REGISTRY / "vk.xml").getroot()
    files = {}
    for element, attribute, bitmask in (
        ("syncstage", "stage", "VkPipelineStageFlagBits2"),
        ("syncaccess", "access", "VkAccessFlagBits2"),
    ):
        defined = {flag.name for flag in vk.bitmasks[bitmask].flags}
        for sync in registry.findall(f"sync/{element}"):
            equivalent = sync.find("syncequivalent")
            if equivalent is None:
                continue
            flags = equivalent.get(attribute)
            if flags is None:
                raise RuntimeError(
                    f"vk.xml: <syncequivalent> of {sync.get('name')} has no `{attribute}` attribute"
                )
            files[f"sync/flagDefinitions/{sync.get('name')}.adoc"] = [
                f"  ** ename:{flag}" for flag in flags.split(",") if flag in defined
            ]
    return files


def spec_condition_holds(directive: str, target: str, defined: set[str]) -> bool:
    # Asciidoctor: `a,b` asks for any of the names, `a+b` for all of them.
    if "," in target:
        result = any(name in defined for name in target.split(","))
    elif "+" in target:
        result = all(name in defined for name in target.split("+"))
    else:
        result = target in defined
    return result if directive == "ifdef" else not result


def spec_lines(
    path: Path,
    defined: set[str],
    tag: str | None = None,
    depth: int = 0,
    local_attributes: dict[str, str] | None = None,
    generated: dict[str, list[str]] | None = None,
):
    """The lines of a specification source file that a build with `defined` keeps, with
    tagged includes of other chapters expanded, and with the lines of the files in
    `generated` in place of their includes. With `tag`, only that tagged region.

    Attributes that the sources set on the way (`:name: value`) are replaced where they
    are referenced; the ones from the specification's configuration are left as `{name}`
    and dumped separately, because their values are formatted text."""
    if depth > 8:
        raise RuntimeError(f"{path}: includes nest too deeply")
    if local_attributes is None:
        local_attributes = {}
    if generated is None:
        generated = {}

    def replace(reference):
        return local_attributes.get(reference.group(1), reference.group(0))

    conditions: list[bool] = []
    in_region = tag is None
    for line in path.read_text().splitlines():
        marker = SPEC_TAG_MARKER.match(line)
        if marker:
            if tag is not None and marker.group(2) == tag:
                in_region = marker.group(1) == "tag"
            continue
        if not in_region:
            continue
        conditional = SPEC_CONDITIONAL.match(line)
        if conditional:
            directive, target, inline_text = conditional.groups()
            holds = spec_condition_holds(directive, target, defined)
            if inline_text:
                if holds and all(conditions):
                    yield SPEC_ATTRIBUTE_REFERENCE.sub(replace, inline_text)
            else:
                conditions.append(holds)
            continue
        if SPEC_END_CONDITIONAL.match(line):
            if conditions:
                conditions.pop()
            continue
        if line.startswith("ifeval::"):
            raise RuntimeError(f"{path}: ifeval is not supported")
        if not all(conditions):
            continue
        include = SPEC_INCLUDE_TAG.match(line)
        if include:
            yield from spec_lines(
                DOCS / "chapters" / include.group(1),
                defined,
                include.group(2),
                depth + 1,
                local_attributes,
                generated,
            )
            continue
        generated_file = SPEC_INCLUDE_GENERATED.match(line)
        if generated_file and generated_file.group(1) in generated:
            yield from generated[generated_file.group(1)]
            continue
        entry = SPEC_ATTRIBUTE_ENTRY.match(line)
        if entry:
            name, unset, value = entry.groups()
            if unset:
                local_attributes.pop(name, None)
            else:
                local_attributes[name] = SPEC_ATTRIBUTE_REFERENCE.sub(replace, value)
            yield line
            continue
        yield SPEC_ATTRIBUTE_REFERENCE.sub(replace, line)


def spec_is_comment(line: str) -> bool:
    stripped = line.strip()
    return stripped.startswith("//") and not stripped.startswith("////")


def spec_is_first_level_item(line: str) -> bool:
    item = SPEC_LIST_ITEM.match(line)
    return bool(item) and len(item.group(1)) == 1 and not spec_is_comment(line)


def spec_list_item(body: list[str], start: int) -> tuple[list[str], int, str | None]:
    """The first-level list item that starts at `body[start]`, to the line where Asciidoctor
    ends it: its lines, the index of the line after it, and what in it could be read in
    two ways, if anything.

    The text of an item goes on over the following lines, whatever they start with, to the
    next first-level item, to an empty line or to the delimiter of a block. Past empty
    lines the item goes on only with a nested item, with the first item of a list of
    another kind (which is nested in the item as well) or with a list continuation; a
    comment after the empty lines ends the item, whatever follows it. A term that has no
    description on its line takes the text after the empty lines as its description. A
    list continuation (a line that is just `+`) attaches the next block to the item: a
    paragraph, a nested list, or a delimited block with the attribute and title lines
    above it. The block may follow after one empty line and after lines that set
    attributes, but not after a comment, which takes the place of the block.

    Where Asciidoctor reads something else than the lines say, the item cannot be read
    reliably: an indented paragraph after an empty line or after a list continuation is a
    literal block, an indented `//` is text, the indented lines after a list continuation
    go on to the next empty line even over a first-level item, a list continuation that
    two empty lines follow attaches nothing but still acts on the lines after it, and a
    comment between a term and its description after empty lines does not end the item.

    The lines come back without their indentation, except inside a delimited block, and
    except for a line of the text that would read as a continuation, as attributes or as a
    delimiter without it: Asciidoctor reads those only at the left margin. The empty line
    and the attribute lines between a list continuation and its block are left out."""
    lines = [SPEC_LIST_ITEM.match(body[start]).group(2)]
    index = start + 1
    attaching = False
    indented_after_a_continuation = False
    problem = None

    def lacks_a_description(text):
        term = SPEC_TERM.match(text)
        return bool(term) and term.group(1) is None

    needs_a_description = lacks_a_description(lines[0])
    while index < len(body):
        line = body[index].rstrip()
        stripped = line.strip()
        if spec_is_comment(line):
            if line[0].isspace():
                problem = problem or "an indented line that starts with `//`"
            attaching = False
            needs_a_description = False
            index += 1
            continue
        if spec_is_first_level_item(line):
            if indented_after_a_continuation:
                problem = problem or "a first-level item in the indented lines after a list continuation"
            break
        if not stripped:
            indented_after_a_continuation = False
            following = index
            while following < len(body) and not body[following].strip():
                following += 1
            if following == len(body):
                break
            after = body[following].rstrip()
            if spec_is_comment(after):
                if after[0].isspace():
                    problem = problem or "an indented line that starts with `//`"
                elif attaching:
                    problem = problem or "a comment after a list continuation and an empty line"
                elif needs_a_description:
                    problem = problem or "a comment between a term and its description"
                break
            item = SPEC_LIST_ITEM.match(after)
            first_level = bool(item and len(item.group(1)) == 1)
            if attaching and following == index + 1 and not first_level:
                if lines[-1] != SPEC_LIST_CONTINUATION:
                    problem = problem or "an empty line between the attributes of a block and the block"
                index = following
                continue
            nested = bool(item and not first_level) or bool(SPEC_OTHER_LIST_ITEM.match(after))
            if after != SPEC_LIST_CONTINUATION and not nested:
                if first_level:
                    break
                if not needs_a_description:
                    if after[0].isspace():
                        problem = problem or "an indented paragraph after an empty line"
                    break
                plain = not (
                    SPEC_BLOCK_DELIMITER.match(after.strip())
                    or SPEC_BLOCK_HEADER.match(after.strip())
                    or SPEC_ATTRIBUTE_ENTRY.match(after.strip())
                    or after.startswith("include::")
                )
                if not plain:
                    problem = problem or "a term whose description after an empty line is not text"
                    break
                lines.extend(["", after.strip()])
                needs_a_description = False
                index = following + 1
                continue
            if attaching:
                problem = problem or "a list continuation that attaches nothing"
                lines.pop()
                attaching = False
            lines.append("")
            index = following
            continue
        at_margin = not line[0].isspace()
        if line == SPEC_LIST_CONTINUATION:
            if attaching:
                problem = problem or "two list continuations in a row"
            lines.append(line)
            attaching = True
            indented_after_a_continuation = False
            needs_a_description = False
            index += 1
            continue
        if at_margin and attaching and SPEC_ATTRIBUTE_ENTRY.match(line):
            index += 1
            continue
        if attaching and not at_margin:
            if SPEC_LIST_ITEM.match(line) or SPEC_OTHER_LIST_ITEM.match(line):
                indented_after_a_continuation = True
            else:
                problem = problem or "an indented line after a list continuation"
        if at_margin and SPEC_BLOCK_DELIMITER.match(line):
            if not attaching:
                break
            end = index + 1
            while end < len(body) and body[end].rstrip() != line:
                end += 1
            if end == len(body):
                problem = problem or f"the block that `{line}` opens does not end"
            lines.extend(inside.rstrip() for inside in body[index : end + 1])
            needs_a_description = False
            attaching = False
            index = end + 1
            continue
        if at_margin and SPEC_BLOCK_ATTRIBUTES.match(line) and not attaching:
            # The attributes of a block end the text. A delimited block that is not
            # attached is outside the list, and so are its attributes.
            block = index
            while block < len(body) and SPEC_BLOCK_HEADER.match(body[block].rstrip()):
                block += 1
            if block == len(body) or not SPEC_BLOCK_DELIMITER.match(body[block].rstrip()):
                problem = problem or f"the attributes `{line}` in the text of the item"
            break
        if at_margin and attaching and SPEC_BLOCK_HEADER.match(line) and not line.startswith("[["):
            lines.append(line)
            index += 1
            continue
        if at_margin and line.startswith(SPEC_INCLUDES_AFTER_AN_ITEM):
            break
        reads_differently_at_the_margin = not at_margin and (
            stripped == SPEC_LIST_CONTINUATION
            or SPEC_BLOCK_ATTRIBUTES.match(stripped)
            or SPEC_BLOCK_DELIMITER.match(stripped)
        )
        lines.append(line if reads_differently_at_the_margin else stripped)
        needs_a_description = lacks_a_description(stripped)
        attaching = False
        index += 1
    while lines[-1] in ("", SPEC_LIST_CONTINUATION):
        lines.pop()
    return lines, index, problem


def spec_described_items(
    body: list[str], where: str, described_name: re.Pattern = SPEC_DESCRIBED_NAME
) -> list[dict[str, str]]:
    """The first-level list items of `body` (the lines of a reference page block, or lines
    outside the blocks) that start with a name that `described_name` matches, `pname:x` or
    `ename:x`, in the order of the lines, each with everything that belongs to it: nested
    items and the blocks that list continuations attach stay part of the item's text.
    `where` names the lines in an error.

    An item is dumped under the first name that it starts with. One name can have several
    items, and an item can start with several names (`pname:x and pname:y are ...`): the
    generator picks the item for a name. The items of valid usage, which start with a
    `[[VUID-...]]` anchor, state a requirement and do not describe what they name, so they
    are left out. So are the items in the cells of a table, which end where their cell
    ends and not where a list item does."""
    described = []
    index = 0
    while index < len(body):
        if SPEC_TABLE_DELIMITER.match(body[index]):
            index = spec_table_end(body, index) + 1
            continue
        if not spec_is_first_level_item(body[index]):
            index += 1
            continue
        lines, index, problem = spec_list_item(body, index)
        if lines[0].startswith("[[VUID-"):
            continue
        lines[0] = SPEC_ANCHOR.sub("", lines[0])
        if not lines[0]:
            lines.pop(0)
        if not lines:
            continue
        lines[0] = SPEC_ANCHOR.sub("", lines[0])
        name = described_name.match(lines[0])
        if name:
            if problem:
                raise RuntimeError(
                    f"{where}: the list item of {name.group(1)} cannot be read reliably: {problem}"
                )
            for line in lines:
                if line.startswith("include::"):
                    raise RuntimeError(
                        f"{where}: the list item of {name.group(1)} goes on in a file that is not read: {line}"
                    )
            described.append({"name": name.group(1), "text": "\n".join(lines)})
    return described


def spec_page_blocks(lines: list[str]) -> list[tuple[int, int, dict[str, str]]]:
    """The reference page blocks of a file: the index of the line that opens each one
    (`[open,refpage=...]`), the index of the delimiter that closes it, and its attributes."""
    blocks = []
    index = 0
    while index < len(lines):
        refpage = SPEC_REFPAGE.match(lines[index])
        if not refpage or index + 1 >= len(lines) or lines[index + 1].strip() != "--":
            index += 1
            continue
        attributes = {
            key: value.replace("\\'", "'")
            for key, value in SPEC_REFPAGE_ATTRIBUTE.findall(refpage.group(1))
        }
        end = index + 2
        while end < len(lines) and lines[end].strip() != "--":
            end += 1
        blocks.append((index, end, attributes))
        index = end + 1
    return blocks


def spec_items_outside_pages(
    file: str, lines: list[str], blocks: list[tuple[int, int, dict[str, str]]]
) -> list[dict[str, str]]:
    """The first-level list items outside every reference page block that start with
    `ename:x`, in the order of the file and read as the items of a block are, each with
    the source file.

    The specification describes some values in a list after the block of their type, or
    in a list of its running text. Most items out here only mention a value, in a list of
    the values that something applies to: the generator tells the two apart, and takes an
    item only for a value that the block of its type does not describe."""
    items = []
    start = 0
    for first, last, _ in [*blocks, (len(lines), len(lines), {})]:
        where = f"{file}, outside the reference pages"
        for item in spec_described_items(lines[start:first], where, SPEC_DESCRIBED_VALUE):
            items.append({"file": file, **item})
        start = last + 1
    return items


def spec_attributes(defined: set[str]) -> dict[str, str]:
    """The text replacements (`{times}` and the like) that the specification defines."""
    attributes = {}
    for line in spec_lines(DOCS / "config" / "attribs.adoc", defined):
        entry = SPEC_ATTRIBUTE_ENTRY.match(line)
        if entry:
            name, _, value = entry.groups()
            passthrough = SPEC_PASSTHROUGH.match(value)
            attributes[name] = passthrough.group(1) if passthrough else value
    return attributes


def spec_anchor_titles(sources: list[Path]) -> dict[str, str]:
    """The title of the section, block or figure that follows each anchor. Asciidoctor
    shows it as the text of a cross reference that has no text of its own (`<<anchor>>`)."""
    titles = {}
    for source in sources:
        anchors: list[str] = []
        for line in source.read_text().splitlines():
            anchor = SPEC_ANCHOR_LINE.match(line)
            if anchor:
                anchors.append(anchor.group(1))
                continue
            if not anchors or line.startswith(("ifdef::", "ifndef::", "endif::", "//", "[")):
                continue
            for pattern in (SPEC_SECTION_TITLE, SPEC_BLOCK_TITLE, SPEC_IMAGE_TITLE):
                title = pattern.match(line)
                if title:
                    for name in anchors:
                        titles.setdefault(name, title.group(1))
                    break
            if line.strip():
                anchors = []
    return titles


def spec_defined_anchors(lines: list[str]) -> set[str]:
    """The anchors (`[[name]]`, on a line of their own or inside one) that the lines of a
    source file define."""
    return {
        anchor
        for line in lines
        if not spec_is_comment(line)
        for anchor in SPEC_ANCHOR_DEFINITION.findall(line)
    }


def spec_is_page(name: str, text: str) -> bool:
    """Whether the Antora build publishes the source file with this name and text as a
    page of its own, at the path of the file. It does so for a file whose first title, in
    its first lines, is a top-level one; every other file is a partial, which the pages
    include."""
    if not SPEC_PAGE_FILE_NAME.fullmatch(name) or name == "vulkanscdeviations.adoc":
        return False
    for line in text.splitlines()[:SPEC_PAGE_TITLE_SEARCH_LINES]:
        if SPEC_TITLE_ANCHOR.match(line):
            continue
        if SPEC_PAGE_TITLE.match(line):
            return True
        if SPEC_PARTIAL_TITLE.match(line):
            return False
    return False


def spec_term_anchors(lines: list[str]) -> dict[str, str]:
    """The anchors that the lines of a source file have at the start of the term of a
    description list (`[[name]]Term:: ...`), each with the term. Asciidoctor shows the
    term as the text of a cross reference to such an anchor that has no text of its own."""
    terms = {}
    for line in lines:
        term = SPEC_TERM_ANCHOR.match(line)
        if term:
            terms[term.group(1)] = term.group(2).strip()
    return terms


REGISTRY_LINKS = "the registry links to"


def spec_named_anchors(
    referenced: dict[str, list[str]],
    titles: dict[str, str],
    defined_anchors: dict[str, set[str]],
    term_anchors: dict[str, dict[str, str]],
) -> dict[str, str]:
    """The anchors that the dumped texts refer to without a text of their own
    (`<<anchor>>`) and whose name Asciidoctor shows, in brackets, as the text of the link:
    the ones that have no title and no other text. Each comes with the words that say
    what refers to it. `referenced` gives the places that refer to each anchor, `titles`
    the anchors with a title, `defined_anchors` the anchors that each source file
    defines as `[[anchor]]` and `term_anchors` the ones that each file has at the start
    of a term.

    Asciidoctor shows the name where an anchor has nothing else to show, as in front of
    a list item. An anchor at the start of a term stops the generation, because
    Asciidoctor shows the term, and so does one that no source file defines as
    `[[anchor]]`: what Asciidoctor shows for it depends on how the specification
    defines it."""
    named = {}
    for anchor in sorted(referenced):
        if anchor in titles:
            continue
        places = sorted(set(referenced[anchor]))
        verb = "refers" if len(places) == 1 else "refer"
        refers = f"{' and '.join(places)} {verb}, without a text, to"
        for file in sorted(term_anchors):
            if anchor in term_anchors[file]:
                raise RuntimeError(
                    f"{refers} the anchor `{anchor}` of the specification, which is at the "
                    f"start of the term `{term_anchors[file][anchor]}` of a description list "
                    f"in {file}. Asciidoctor shows the term as the text of the reference, and "
                    "this script does not dump it: spec_anchor_titles has to learn to read "
                    "the term"
                )
        if not any(anchor in anchors for anchors in defined_anchors.values()):
            raise RuntimeError(
                f"{refers} the anchor `{anchor}` of the specification, which no source file "
                f"defines as `[[{anchor}]]`. If the specification generates the anchor when "
                "it is built, as it does for the appendix of an extension, or defines it "
                f"with a text (`[[{anchor}, text]]`), Asciidoctor shows a title or that text, "
                "and spec_anchor_titles has to learn to read it. If nothing defines the "
                f"anchor, Asciidoctor shows `[{anchor}]` as a link that leads nowhere"
            )
        named[anchor] = refers
    return named


def spec_anchor_pages(
    anchors: dict[str, str], defined_anchors: dict[str, set[str]], pages: set[str]
) -> dict[str, str]:
    """The page that each of `anchors` is on: the one source file that defines it, given
    the anchors that each source file defines and the source files that are pages. An
    anchor in a partial is on every page that includes the partial, and which pages do is
    not read here, so it stops the generation. `anchors` gives, for each anchor, the words
    that say what refers to it (`REGISTRY_LINKS`, or the ones of `spec_named_anchors`),
    for the message of a stop."""
    anchor_pages = {}
    for anchor in sorted(anchors):
        refers = anchors[anchor]
        defining = sorted(file for file, defined in defined_anchors.items() if anchor in defined)
        if len(defining) != 1:
            raise RuntimeError(
                f"{refers} the anchor `{anchor}` of the specification, which "
                f"{' and '.join(defining) or 'no source file'} defines: exactly one source "
                "file has to define it"
            )
        if defining[0] not in pages:
            raise RuntimeError(
                f"{refers} the anchor `{anchor}` of the specification, which "
                f"{defining[0]} defines, and that file is not published as a page of its "
                "own: it has no top-level title in its first "
                f"{SPEC_PAGE_TITLE_SEARCH_LINES} lines, or not the name of a page"
            )
        anchor_pages[anchor] = defining[0]
    return anchor_pages


def spec_table_end(lines: list[str], index: int) -> int:
    """The index of the delimiter that closes the table that `lines[index]` opens, or the
    number of lines if nothing closes it."""
    delimiter = lines[index].strip()
    end = index + 1
    while end < len(lines) and lines[end].strip() != delimiter:
        end += 1
    return end


def spec_tables(file: str, lines: list[str], page_blocks: list[tuple[int, int, str]]) -> list[dict]:
    """The tables (`|===` blocks) that name an enumerant, as AsciiDoc text that starts
    with the attribute, anchor and title lines above the table, and the reference page
    block that each one is in, if any, and the source file."""
    tables = []
    index = 0
    while index < len(lines):
        if not SPEC_TABLE_DELIMITER.match(lines[index]):
            index += 1
            continue
        end = spec_table_end(lines, index)
        start = index
        while start > 0 and SPEC_BLOCK_HEADER.match(lines[start - 1]):
            start -= 1
        if any("ename:" in line for line in lines[index + 1 : end]):
            page = next((name for first, last, name in page_blocks if first < index < last), None)
            tables.append({"file": file, "page": page, "text": "\n".join(lines[start : end + 1])})
        index = end + 1
    return tables


def build_docs(defined: set[str], generated: dict[str, list[str]], linked_anchors: set[str]):
    """`linked_anchors` are the anchors of the specification that the registry links to.
    The page that each one is on is dumped, as the path of its source file, because the
    specification is published as many pages. So is the page of each anchor that a
    dumped text refers to without a text of its own (`<<anchor>>`) and that has no title
    and no other text that Asciidoctor would show (`spec_named_anchors`): Asciidoctor
    shows the name of such an anchor as the text of the link."""
    pages = {}
    tables = []
    items_outside_pages = []
    defined_anchors = {}
    term_anchors = {}
    published = set()
    sources = sorted([*DOCS.glob("chapters/**/*.adoc"), *DOCS.glob("appendices/**/*.adoc")])
    for source in sources:
        file = str(source.relative_to(DOCS))
        lines = list(spec_lines(source, defined, generated=generated))
        defined_anchors[file] = spec_defined_anchors(lines)
        term_anchors[file] = spec_term_anchors(lines)
        if spec_is_page(source.name, source.read_text()):
            published.add(file)
        blocks = spec_page_blocks(lines)
        for index, end, attributes in blocks:
            name = attributes["refpage"]
            if name in pages:
                raise RuntimeError(f"{source}: a second reference page for {name}")
            pages[name] = {
                "name": name,
                "kind": attributes.get("type", ""),
                "desc": attributes.get("desc", "").strip(),
                "aliases": attributes.get("alias", "").split(),
                "file": file,
                "items": spec_described_items(lines[index + 2 : end], name),
            }
        page_blocks = [(index, end, attributes["refpage"]) for index, end, attributes in blocks]
        tables.extend(spec_tables(file, lines, page_blocks))
        items_outside_pages.extend(spec_items_outside_pages(file, lines, blocks))
    if not pages:
        raise RuntimeError("third_party/vulkan-docs has no reference page blocks")
    all_titles = spec_anchor_titles(sources)
    referenced = {}

    def refer(place: str, text: str):
        for anchor in SPEC_BARE_REFERENCE.findall(text):
            referenced.setdefault(anchor, []).append(place)

    for page in pages.values():
        refer(f"the description of the page {page['name']}", page["desc"])
        for item in page["items"]:
            refer(f"the description of {item['name']} on the page {page['name']}", item["text"])
    for table in tables:
        refer(f"a table of {table['page'] or table['file']}", table["text"])
    for item in items_outside_pages:
        refer(f"the description of {item['name']} in {item['file']}", item["text"])
    named_anchors = spec_named_anchors(referenced, all_titles, defined_anchors, term_anchors)
    return {
        "anchors": spec_anchor_pages(
            {**named_anchors, **{anchor: REGISTRY_LINKS for anchor in linked_anchors}},
            defined_anchors,
            published,
        ),
        "attributes": dict(sorted(spec_attributes(defined).items())),
        "titles": {name: all_titles[name] for name in sorted(referenced) if name in all_titles},
        "pages": [pages[name] for name in sorted(pages)],
        "tables": tables,
        "items_outside_pages": items_outside_pages,
    }


def param_ir(p):
    return {
        "name": p.name,
        "ty": p.type,
        "full_ty": p.fullType,
        "optional": p.optional,
        "optional_pointer": p.optionalPointer,
        "len": p.length,
        "null_terminated": p.nullTerminated,
        "fixed_size_array": list(p.fixedSizeArray),
    }


def member_ir(m):
    ir = param_ir(m)
    ir["bit_field_width"] = m.bitFieldWidth
    return ir


def effective_protect(vk, item):
    if item.protect:
        return item.protect
    for ext_name in item.extensions or []:
        ext = vk.extensions.get(ext_name)
        if ext and ext.protect:
            return ext.protect
    return None


def constant_value(c) -> str:
    if c.type == "float":
        return repr(float(c.value))
    return str(int(c.value))


def attr(obj, name: str):
    # Attribute access is otherwise direct on purpose: if Khronos renames or drops a
    # VulkanObject field, generation must fail loudly instead of emitting a silent default.
    return getattr(obj, name, None)


def git(args, allow_fail=False):
    try:
        return subprocess.check_output(["git", *args], cwd=ROOT, text=True).strip()
    except subprocess.CalledProcessError:
        if allow_fail:
            return ""
        raise


